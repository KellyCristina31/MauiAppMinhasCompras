<?xml version="1.0" encoding="utf-8" ?>
    [
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.RelatorioCategorias"
             Title="RelatorioCategorias">
    <CollectionView ItemsSource="{Binding Relatorio}">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <StackLayout Padding="10">
                    <Label Text="{Binding Categoria}" FontAttributes="Bold" />
                    <Label Text="{Binding Total, StringFormat='Total: R$ {0:F2}'}" />
                </StackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>